<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ItemCountExpander</AssemblyName>
    <RootNamespace>ItemCountExpander</RootNamespace>
    <Version>2.0.0</Version>
    <!-- Keep deploy output minimal: module dll + 0Harmony.dll only. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Compile-time reference to the game assemblies (Assembly-CSharp.dll, SDG.*).
      Excluded from runtime output: the game process provides them already.
    -->
    <PackageReference Include="RocketModFix.Unturned.Redist.Server" Version="3.26.3.12" ExcludeAssets="runtime" />
    <!--
      Unturned types derive from UnityEngine.MonoBehaviour, so the engine
      assemblies are required to resolve base-type chains (CS0012 otherwise).
    -->
    <PackageReference Include="RocketModFix.UnityEngine.Redist" Version="2022.3.62.3" ExcludeAssets="runtime" />
    <!--
      Shipped with the module on purpose: neither Unturned nor Rocket bundles
      Harmony, so the module must carry its own 0Harmony.dll.
    -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

</Project>
